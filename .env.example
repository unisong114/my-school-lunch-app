# NEIS 공개 API 인증 키 (https://open.neis.go.kr 에서 발급)
# 비워 두면 인증 없이 동작하지만 호출량이 제한될 수 있습니다.
NEIS_API_KEY=

# 백엔드 CORS 허용 Origin (쉼표 구분). 기본값은 모든 Origin 허용.
CORS_ALLOW_ORIGINS=*

# MCP 서버(src/mcp) Streamable HTTP 바인딩 설정
MCP_HOST=0.0.0.0
MCP_PORT=8100

# 멀티 에이전트 앱(agent/)이 급식 MCP 서버(src/mcp)에 연결할 URL.
MCP_SERVER_URL=http://localhost:8100/mcp

# GitHub Copilot SDK 인증에 사용하는 GitHub 토큰 (agent/ 실행에 필요).
GITHUB_TOKEN=
