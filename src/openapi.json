{
  "openapi": "3.0.3",
  "info": {
    "title": "급식 배틀 내부 API",
    "description": "프론트엔드(React)와 백엔드(FastAPI) 간 통신 계약입니다. 프론트엔드는 이 명세만을 근거로 백엔드와 통신하며, NEIS API를 직접 호출하지 않습니다.",
    "version": "0.1.0"
  },
  "servers": [
    { "url": "/", "description": "백엔드 API (동일 오리진 프록시)" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "헬스 체크",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "정상",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "version": { "type": "string" }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/api/schools": {
      "get": {
        "summary": "부분 학교명으로 학교 검색",
        "operationId": "searchSchools",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "검색할 학교명 일부",
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "학교 검색 결과 (일치 항목이 없으면 빈 목록)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SchoolSearchResponse" }
              }
            }
          },
          "422": {
            "description": "잘못된 요청 파라미터",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "502": {
            "description": "NEIS API 오류",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/meals": {
      "get": {
        "summary": "학교와 날짜 범위로 중식 급식 조회",
        "operationId": "getMeals",
        "parameters": [
          {
            "name": "eduOfficeCode",
            "in": "query",
            "required": true,
            "description": "시도교육청코드",
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "schoolCode",
            "in": "query",
            "required": true,
            "description": "행정표준코드",
            "schema": { "type": "string", "minLength": 1 }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "description": "조회 시작일 (YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "description": "조회 종료일 (YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "날짜별 중식 급식 결과 (급식이 없으면 빈 목록)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MealQueryResponse" }
              }
            }
          },
          "400": {
            "description": "잘못된 날짜 범위",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "502": {
            "description": "NEIS API 오류",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "School": {
        "type": "object",
        "properties": {
          "eduOfficeCode": { "type": "string", "description": "시도교육청코드" },
          "eduOfficeName": { "type": "string", "description": "시도교육청명" },
          "schoolCode": { "type": "string", "description": "행정표준코드" },
          "schoolName": { "type": "string", "description": "학교명" },
          "schoolKind": { "type": "string", "nullable": true, "description": "학교종류명" },
          "region": { "type": "string", "nullable": true, "description": "시도명" },
          "address": { "type": "string", "nullable": true, "description": "도로명주소" }
        },
        "required": ["eduOfficeCode", "eduOfficeName", "schoolCode", "schoolName"]
      },
      "SchoolSearchResponse": {
        "type": "object",
        "properties": {
          "schools": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/School" }
          }
        },
        "required": ["schools"]
      },
      "MealDish": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "요리명" },
          "allergies": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "알레르기 유발 식품 번호"
          }
        },
        "required": ["name", "allergies"]
      },
      "DailyMeal": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date", "description": "급식일자" },
          "mealName": { "type": "string", "description": "식사구분명" },
          "dishes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MealDish" }
          },
          "calorie": { "type": "string", "nullable": true },
          "nutrition": { "type": "string", "nullable": true },
          "origin": { "type": "string", "nullable": true }
        },
        "required": ["date", "mealName", "dishes"]
      },
      "MealQueryResponse": {
        "type": "object",
        "properties": {
          "schoolCode": { "type": "string" },
          "fromDate": { "type": "string", "format": "date" },
          "toDate": { "type": "string", "format": "date" },
          "meals": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DailyMeal" }
          }
        },
        "required": ["schoolCode", "fromDate", "toDate", "meals"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "detail": { "type": "string", "description": "오류 메시지" }
        },
        "required": ["detail"]
      }
    }
  }
}
